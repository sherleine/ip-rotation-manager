# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Decodo Web Data API key from the dashboard (or an older plan's Basic auth token).
WEBDATA_API_KEY=
# Optional. Leave commented: the endpoint is picked from the key type.
# WEBDATA_API_URL=
# Optional. Set to 1 only if pages come back without content (JS rendering costs more).
WEBDATA_JS_RENDER=0

# Optional local LLM for owner/founder names (py -m app.leads enrich).
# Any OpenAI-compatible server: Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
